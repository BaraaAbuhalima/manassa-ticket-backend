# Copy to .env (gitignored) and fill in real values.
#
# Names with a double underscore (e.g. Stripe__SecretKey) map 1:1 onto ASP.NET Core's
# nested config paths (Stripe:SecretKey in appsettings.json) — compose passes them straight
# through to the containers with no renaming.
#
# To deploy: fill in the real secrets below, set ASPNETCORE_ENVIRONMENT and COMPOSE_PROFILES
# for the target environment, then run `docker compose up --build`. Nothing else needs to
# change between dev and production.

# Development enables Swagger/error pages; Production disables them.
ASPNETCORE_ENVIRONMENT=Development

# Set to "dev" to also start rabbitmq (local broker), mailhog (fake SMTP), and the
# stripe-cli webhook forwarder. Leave blank/unset in production — production connects to
# an external managed RabbitMQ broker and a real SMTP provider instead (see below).
COMPOSE_PROFILES=dev

# ---- Stripe (Dashboard -> Developers -> API keys / Webhooks) ----
Stripe__SecretKey=sk_test_REPLACE_ME
Stripe__PublishableKey=pk_test_REPLACE_ME
# In dev, scripts/dev.ps1 overrides this automatically from the stripe-cli container's
# output. In production, use the signing secret from the webhook endpoint you register in
# the Dashboard for your public HTTPS domain.
Stripe__WebhookSecret=whsec_REPLACE_ME
# Only used by the dev-only stripe-cli container to authenticate `stripe listen`.
# Prefer a restricted key (rk_test_...) scoped to Events: Read + Webhook Endpoints: Read.
STRIPE_API_KEY=rk_test_REPLACE_ME

# ---- CORS ----
# Dev: leave unset. appsettings.json's default (http://localhost:5173) covers the local
# Vite dev server.
#
# Production: the frontend's real domain(s) — indexed since ASP.NET Core binds arrays from
# env vars as Cors__AllowedOrigins__0, __1, etc. Uncomment and add one line per domain.
 Cors__AllowedOrigins__0=https://manassa-ticket.com
 Cors__AllowedOrigins__1=https://jett-ticket.duckdns.org

# ---- Frontend ----
# The frontend's own base URL (not a CORS origin) — used to build links back to the site
# in outgoing emails (e.g. "a ticket is available" notifications). Not a secret.
# Dev: leave unset, appsettings.json's default (http://localhost:5173) applies.
# Production: uncomment and set to the real frontend domain, no trailing slash.
# Frontend__BaseUrl=https://manassa-ticket.com

# ---- Buyer service fee ----
# Charged on top of the ticket's listed price at checkout: FlatFeeUsd + (price * PercentFee / 100).
# Not secrets — safe to leave unset, in which case appsettings.json's defaults (1 USD + 5%) apply.
# Uncomment to override. Both must be >= 0 — the app fails to start otherwise.
# Fee__FlatFeeUsd=1
# Fee__PercentFee=5

# ---- Ticket pricing ----
# The most a seller's asking price may exceed the original ticket's printed price, in JOD.
# Not a secret — safe to leave unset, in which case appsettings.json's default (1 JOD) applies.
# Uncomment to override. Must be >= 0 — the app fails to start otherwise.
# TicketPricing__MaxAskingPriceIncreaseJod=1

# ---- JWT (ticket delete tokens) ----
# Generate a new one per environment, e.g.: openssl rand -hex 32
Jwt__SigningKey=REPLACE_WITH_A_RANDOM_HEX_STRING

# ---- RabbitMQ ----
# Dev: leave these as-is. COMPOSE_PROFILES=dev starts a local rabbitmq container (guest/guest,
# no TLS) and HostName/Port/VirtualHost/UseTls fall back to appsettings.json's defaults
# ("rabbitmq", 5672, "/", false) when left unset here.
RabbitMq__UserName=guest
RabbitMq__Password=guest
#
# Production: point at an external managed RabbitMQ broker (e.g. CloudAMQP, Amazon MQ, or
# similar hosted provider) instead of the local container — uncomment and fill these in from
# the provider's connection details, and set real values for UserName/Password above:
#   - Host: the provider's hostname (NOT "rabbitmq" — that only resolves in the dev compose network)
#   - Port: typically 5671 for AMQP over TLS (vs. 5672 plaintext)
#   - Virtual host: often a per-instance name the provider assigns you, not "/"
#   - TLS: enable it — managed brokers are reached over the public internet
# RabbitMq__HostName=your-external-broker-host
# RabbitMq__Port=5671
# RabbitMq__VirtualHost=your-vhost
# RabbitMq__UseTls=true

# ---- SMTP ----
# Dev default points at the bundled Mailhog fake SMTP server; replace all of these for
# production with a real SMTP provider's settings.
Smtp__Host=mailhog
Smtp__Port=1025
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=no-reply@manassa-ticket.local

# ---- Contact Us ----
# Where visitor Contact Us submissions are delivered, and the address the confirmation
# email back to the visitor is sent from (a real inbox someone reads, not the no-reply
# sender above). It's a separate mailbox/login from Smtp__Username, so it needs its own
# SMTP credentials to authenticate as itself.
# Dev: leave unset, appsettings.json's default (a placeholder .local address, no credentials) applies.
# Production: uncomment and set to your real support inbox and its SMTP login.
# Contact__RecipientEmail=support@manassa-ticket.com
# Contact__SmtpUsername=support@manassa-ticket.com
# Contact__SmtpPassword=REPLACE_WITH_SUPPORT_MAILBOX_SMTP_PASSWORD

# ---- Cloudflare R2 (ticket PDF storage) ----
# Dashboard -> R2 -> Manage API tokens for AccessKeyId/SecretAccessKey, and the account
# home URL for AccountId (the xxxxxxxx in xxxxxxxx.r2.cloudflarestorage.com).
# Use two separate buckets so dev and production data never mix, e.g.
# "manassa-tickets-dev" here and "manassa-tickets-prod" in the production .env.
Storage__R2__AccountId=REPLACE_WITH_R2_ACCOUNT_ID
Storage__R2__AccessKeyId=REPLACE_WITH_R2_ACCESS_KEY_ID
Storage__R2__SecretAccessKey=REPLACE_WITH_R2_SECRET_ACCESS_KEY
Storage__R2__BucketName=manassa-tickets-dev

# ---- Ticket PDF extraction service ----
# Dev: leave unset. appsettings.json's default (http://python-service:8000) resolves to the
# pdf-ticket-extract-service container running alongside api in the same compose network.
#
# Production: point at wherever pdf-ticket-extract-service is actually deployed (its own
# Render/Fly/etc. service, or a sidecar container on an internal network) — uncomment and fill
# in the real URL. It must be reachable from the api container/host, not "python-service" (that
# name only resolves inside the dev compose network).
# PythonTicketExtractorService__BaseUrl=https://your-extraction-service-host
