# Caddy reverse proxy config.
# Replace YOURDOMAIN.com below with your real domain.
# Caddy automatically obtains + renews Let's Encrypt HTTPS certificates
# for any domain listed here, as long as its DNS points at this VPS.

# Backend API -> the "api" container on its internal port 8080.
api.manassa-ticket.com {
    reverse_proxy api:8080
}

# Frontend -> the "frontend" container (nginx serving the built SPA on port 80).
manassa-ticket.com {
    reverse_proxy frontend:80
}
